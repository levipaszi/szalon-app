rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Fix, meghívásos vendégkörű szalon PWA alapszabályok
    // (A jelszó nélküli vendégbelépéshez és az Admin PIN-es eléréshez igazítva)
    match /guests/{guestId} {
      allow read, write: if true;
    }
    match /appointments/{apptId} {
      allow read, write: if true;
    }
    match /sosRequests/{sosId} {
      allow read, write: if true;
    }
    match /flashSlots/{slotId} {
      allow read, write: if true;
    }
    match /settings/{docId} {
      allow read, write: if true;
    }
    match /notificationFlags/{flagId} {
      // Csak a Google Apps Script Service Account írja/olvassa
      allow read, write: if false;
    }
  }
}
